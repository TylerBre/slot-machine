{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slot-machine/commands/lock-prune.json",
  "title": "lock prune",
  "description": "Remove stale worktree locks (owner session dead). Pass slots[] to target specific ones, or stale=true to clear every dead lock. dryRun previews; force removes live locks too.",
  "x-mcp": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "slots": { "type": "array", "items": { "type": "string" } },
    "stale": { "type": "boolean" },
    "dryRun": { "type": "boolean" },
    "force": { "type": "boolean" },
    "olderThan": { "type": "number", "description": "staleness threshold in minutes (default 30)" }
  },
  "x-cli": {
    "path": ["lock", "prune"],
    "args": {
      "slots": { "positional": 0 },
      "stale": { "flag": "--stale" },
      "dryRun": { "flag": "--dry-run" },
      "force": { "flag": "--force" },
      "olderThan": { "flag": "--older-than" }
    }
  }
}
