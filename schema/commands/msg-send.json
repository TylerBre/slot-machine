{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slot-machine/commands/msg-send.json",
  "title": "msg send",
  "description": "Send one submitted line to slot panes (all, or a subset). slots is a comma spec like \"a\", \"1,3,5-6\", or \"a-c,f\".",
  "x-mcp": true,
  "type": "object",
  "required": ["message"],
  "additionalProperties": false,
  "properties": {
    "message": { "type": "string" },
    "slots": { "type": "string", "description": "slot subset spec (optional; default all)" },
    "firstFree": {
      "type": "boolean",
      "description": "send to the first reusable slot with a live worker (resets a merged one first)"
    },
    "brief": { "type": "boolean" },
    "untilIdle": {
      "type": "boolean",
      "description": "keep retrying delivery until each targeted slot's composer accepts the submit, or a timeout"
    },
    "session": { "type": "string" }
  },
  "x-cli": {
    "path": ["msg", "send"],
    "args": {
      "message": { "positional": 0 },
      "slots": { "flag": "--slots", "short": "s" },
      "firstFree": { "flag": "--first-free", "short": "f" },
      "brief": { "flag": "--brief" },
      "untilIdle": { "flag": "--until-idle" },
      "session": { "flag": "--session", "short": "t" }
    }
  }
}
