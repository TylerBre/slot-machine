{
  "name": "slot-machine",
  "type": "module",
  "version": "1.1.2",
  "private": true,
  "description": "Run a fleet of Claude Code agents in parallel against one repo - a CLI (sm) and MCP server that orchestrate tmux + git worktrees (slots) so agents never step on each other.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/tylerbre/slot-machine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylerbre/slot-machine.git"
  },
  "bugs": {
    "url": "https://github.com/tylerbre/slot-machine/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai-agents",
    "agent-orchestration",
    "coding-agent",
    "parallel-agents",
    "tmux",
    "git-worktree",
    "worktree",
    "orchestration",
    "cli",
    "mcp",
    "mcp-server",
    "developer-tools"
  ],
  "bin": {
    "sm": "bin/sm",
    "slot-machine": "bin/slot-machine",
    "slot-machine-mcp": "bin/slot-machine-mcp"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "pack": "git archive --format=tar.gz --prefix=slot-machine/ -o slot-machine-v$npm_package_version.tar.gz HEAD"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "eslint": "^10.6.0"
  }
}
