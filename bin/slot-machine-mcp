#!/usr/bin/env node
// slot-machine-mcp: a zero-dependency stdio MCP server wrapping the `sm` CLI. Each tool
// shells out to `sm <ns> <cmd> ... --json`, so it stays in lockstep with the CLI.
// Newline-delimited JSON-RPC 2.0 on stdin/stdout; diagnostics go to stderr.
import { spawnSync } from 'node:child_process';
import { readdirSync, readFileSync } from 'node:fs';
import { createInterface } from 'node:readline';
import { fileURLToPath } from 'node:url';
import { buildArgv, mcpInputSchema, mcpToolName } from '../lib/argspec.mjs';
import { loadSchema } from '../lib/schema.mjs';

// Spawn the sibling entry point - works from any install location (Node resolves the
// symlink, and bin/sm imports ../lib relative to its real path).
const BIN = fileURLToPath(new URL('./sm', import.meta.url));

// Version, read from package.json so the handshake reports the real build (not a stale literal).
const VERSION = JSON.parse(readFileSync(fileURLToPath(new URL('../package.json', import.meta.url)), 'utf8')).version;

// Hard ceiling on a single CLI call. The server processes one JSON-RPC line at a time, so an
// unbounded call would freeze it; blocking sm ops (lock claim --wait, msg --until-idle) cap at
// ~10 min internally, so 15 min lets them finish while a genuinely stuck child is still killed.
const MCP_CALL_TIMEOUT_MS = 15 * 60_000;

// Run sm with args + --json. Returns the CLI's JSON on success, else an error.
function runSm(args) {
  // Keep --json before any '--' so guarded messages stay positional.
  const dd = args.indexOf('--');
  const argv = dd >= 0 ? [...args.slice(0, dd), '--json', ...args.slice(dd)] : [...args, '--json'];
  const r = spawnSync(BIN, argv, { encoding: 'utf8', timeout: MCP_CALL_TIMEOUT_MS, env: { ...process.env, NO_COLOR: '1' } });
  if (r.error) {
    const timedOut = r.error.code === 'ETIMEDOUT' || r.signal === 'SIGTERM';
    return { ok: false, error: timedOut ? `timed out after ${MCP_CALL_TIMEOUT_MS / 1000}s` : `spawn failed: ${r.error.message}` };
  }
  const out = (r.stdout || '').trim();
  if (r.status !== 0) return { ok: false, error: (r.stderr || out || `exit ${r.status}`).trim() };
  return { ok: true, data: out };
}

// The schema/commands directory, resolved relative to this file (not cwd) so the server
// works from any install location, same as BIN above.
const COMMANDS_DIR = fileURLToPath(new URL('../schema/commands/', import.meta.url));

// tool name -> { description, inputSchema, argv(args) -> string[] }. Built by scanning every
// command's arg-spec and keeping the ones marked x-mcp: true - see lib/argspec.mjs for the
// shared logic that also drives the CLI parser, so the two can't drift.
const TOOLS = {};
for (const file of readdirSync(COMMANDS_DIR).sort()) {
  if (!file.endsWith('.json')) continue;
  const spec = loadSchema(`commands/${file}`);
  if (spec['x-mcp'] !== true) continue;
  TOOLS[mcpToolName(spec)] = {
    description: spec.description,
    inputSchema: mcpInputSchema(spec),
    argv: (args) => buildArgv(spec, args),
  };
}

const send = (msg) => process.stdout.write(JSON.stringify(msg) + '\n');

function handle(req) {
  const { id, method, params } = req;
  if (method === 'initialize') {
    return {
      jsonrpc: '2.0',
      id,
      result: {
        protocolVersion: params?.protocolVersion || '2025-06-18',
        capabilities: { tools: {} },
        serverInfo: { name: 'slot-machine', version: VERSION },
      },
    };
  }
  if (method === 'tools/list') {
    return {
      jsonrpc: '2.0',
      id,
      result: {
        tools: Object.entries(TOOLS).map(([name, t]) => ({
          name,
          description: t.description,
          inputSchema: t.inputSchema,
        })),
      },
    };
  }
  if (method === 'tools/call') {
    const t = TOOLS[params?.name];
    if (!t) return { jsonrpc: '2.0', id, error: { code: -32602, message: `unknown tool: ${params?.name}` } };
    let argv;
    try {
      argv = t.argv(params.arguments || {});
    } catch (e) {
      return {
        jsonrpc: '2.0',
        id,
        result: { content: [{ type: 'text', text: `error: ${e.message}` }], isError: true },
      };
    }
    const res = runSm(argv);
    return {
      jsonrpc: '2.0',
      id,
      result: {
        content: [{ type: 'text', text: res.ok ? res.data : `error: ${res.error}` }],
        isError: !res.ok,
      },
    };
  }
  if (method === 'ping') return { jsonrpc: '2.0', id, result: {} };
  if (id !== undefined)
    return { jsonrpc: '2.0', id, error: { code: -32601, message: `method not found: ${method}` } };
  return null; // notification -> no response
}

createInterface({ input: process.stdin }).on('line', (line) => {
  const s = line.trim();
  if (!s) return;
  let req;
  try {
    req = JSON.parse(s);
  } catch {
    return;
  }
  const resp = handle(req);
  if (resp) send(resp);
});
